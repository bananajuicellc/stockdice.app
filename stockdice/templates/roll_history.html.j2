{% extends 'base.html.j2' %}

{% block title %}Roll History{% endblock %}

{% block content %}
<h2>Roll History</h2>

{% if rolls %}
<div class="roll-history-container">
<table>
  <thead>
    <tr>
      <th>Timestamp</th>
      <th>Company</th>
      <th>Price</th>
      <th>Amount</th>
      <th>Shares</th>
      <th>Type</th>
    </tr>
  </thead>
  <tbody>
    {% for roll in rolls %}
    <tr>
      <td>{{ roll.created_at }}</td>
      <td>{{ roll.company_name }} ({{ roll.symbol }})</td>
      <td>{% if roll.price %}${{ "{:.2f}".format(roll.price) }}{% else %}N/A{% endif %}</td>
      <td>${{ "{:,}".format(roll.roll_amount_dollars) }}</td>
      <td>{% if roll.share_count %}{{ "{:.4f}".format(roll.share_count) }}{% else %}N/A{% endif %}</td>
      <td>{{ roll.roll_type.replace('_', ' ').title() }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
{% else %}
<p>No roll history yet. <a href="{{ url_for('home.english_us') }}">Roll the dice</a> to get started!</p>
{% endif %}
{% endblock %}

